{
  "name": "house-hr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run",
    "prebuild": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "starter:check": "node scripts/check-starter.mjs",
    "verify": "npm run typecheck && npm run lint && npm test -- --maxWorkers=1 && node scripts/adapt-demo-data.mjs --check && npm run starter:check && node scripts/check-release.mjs --self-test && node scripts/check-release.mjs --source-only && npm run build && npm run release:check",
    "publish": "node publish.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@agentshouse/app-bridge": "0.1.0-cc70c9b07c3ec",
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@fontsource/inter": "^5.2.8",
    "@mui/material": "^6.1.7",
    "@mui/utils": "^6.1.6",
    "@mui/x-data-grid": "^8.24.0",
    "@mui/x-date-pickers": "^7.23.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/mui": "8.0.2",
    "@refinedev/react-hook-form": "^5.0.4",
    "@refinedev/react-router": "^2.0.4",
    "@tanstack/react-query": "^5.81.5",
    "dayjs": "^1.10.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.4.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@agentshouse/mdmodel": "0.1.0-c68e2039f1ca8",
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "8.3.2",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "license": "MIT"
}
